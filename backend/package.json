{
  "name": "janasadharana-api",
  "version": "2.0.0",
  "description": "Puri Municipality Grievance Redressal API",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/geo.test.js tests/media.test.js",
    "test:api": "node --test tests/cow-welfare.api.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "nanoid": "^3.3.7",
    "pg": "^8.12.0",
    "pino-pretty": "^11.2.2"
  }
}
