# ─── Janasadharana · Puri Municipality ───────────────────────────
# Copy to .env and change all secrets before production / Coolify.

NODE_ENV=production

# Postgres
POSTGRES_USER=janasadharana
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=janasadharana
# Host port for Postgres (container always uses 5432)
POSTGRES_PORT=15432
DATABASE_URL=postgres://janasadharana:replace-with-strong-password@localhost:15432/janasadharana

# API (host + container listen on 5430)
BACKEND_PORT=5430
PORT=5430
JWT_ACCESS_SECRET=replace-with-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-string-32-chars
# Set false (or omit) in real Coolify deploys after setting strong JWT secrets
ALLOW_INSECURE_DEFAULTS=true
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:5431,https://your-domain.example
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute
PG_POOL_MAX=20

# Puri geofence
PURI_LAT=19.8134
PURI_LNG=85.8245
GEOFENCE_RADIUS_METERS=20000

# Seed staff (change immediately after first login)
SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_PASSWORD=ChangeMeAdmin!23
SEED_OFFICER_PHONE=8888888888
SEED_OFFICER_PASSWORD=ChangeMeOfficer!23
RUN_SEED=true

# Frontend (host + container listen on 5431) — PUBLIC_API_URL must be browser-reachable
FRONTEND_PORT=5431
PUBLIC_API_URL=http://localhost:5430/api/v1

# Cloudflare R2 — cow welfare media
# Bucket layout:
#   cow-welfare-puri/cow-welfare-artefacts/  → images (+ PDFs)
#   cow-welfare-puri/cow-welfare-audios/     → voice notes
#
# Same Cloudflare account keys as ByteSphere (bytesphereinnovation / odia-ai-voice)
# can be reused — paste them here (or copy from that repo’s .env). Only bucket +
# public URL change for the new cow-welfare-puri bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cow-welfare-puri
R2_KEY_PREFIX=
R2_ARTEFACTS_FOLDER=cow-welfare-artefacts
R2_AUDIOS_FOLDER=cow-welfare-audios
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

